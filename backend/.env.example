# SlickTrace v2 Environment Configuration

# Core settings
PROJECT_NAME="SlickTrace v2"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Data Provider Configuration
# Set to 'demo' to use local synthetic data
# Set to 'real' to attempt to fetch live API data
DATA_MODE="demo"

# --- REAL PROVIDER CREDENTIALS ---

# 1. Sentinel-1 & Sentinel-2 (Copernicus SciHub/DataSpace)
# Endpoint: https://scihub.copernicus.eu/dhus/odata/v1/Products
# Expected response: JSON metadata and binary SAFE format imagery.
SENTINEL_HUB_API_KEY=""

# 2. AIS Data (Spire Maritime / ExactEarth)
# Endpoint: https://api.spire.com/ais
# Expected response: JSON array of vessel positions (MMSI, lat, lon, speed, heading, timestamp)
AIS_API_KEY=""
AIS_PROVIDER_URL="https://api.spire.com/ais"

# 3. Metocean (Wind & Ocean Currents)
# Endpoint: https://marine-api.open-meteo.com/v1/marine
# Expected response: JSON containing hourly wind speed/direction and ocean current speed/direction
METOCEAN_API_KEY=""
METOCEAN_PROVIDER_URL="https://marine-api.open-meteo.com/v1/marine"
