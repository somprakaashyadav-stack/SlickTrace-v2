# SlickTrace v2 Environment Configuration

# Core Settings
PROJECT_NAME="SlickTrace v2"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# DEMO MODE (Set to True for offline prototype mode with synthetic datasets)
DEMO_MODE=True
DEMO_DATASET="mumbai_offshore_2026"

# Database Configuration (PostgreSQL + PostGIS, auto-falls back to SQLite if unreachable or SQLite format)
DATABASE_URL="sqlite:///./slicktrace.db"
# For PostgreSQL + PostGIS:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slicktrace_db"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
FRONTEND_URL="http://localhost:5173"

# Future Integration API Keys (Placeholders)
SENTINEL_API_KEY=""
COPERNICUS_USER=""
COPERNICUS_PASSWORD=""
AISSTREAM_API_KEY=""
ECMWF_API_KEY=""
