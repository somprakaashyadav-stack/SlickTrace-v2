# ============================================================
# SlickTrace v2 — Environment Configuration Template
# Copy to .env and fill in real values for REAL MODE.
# SLICKTRACE_MODE=demo requires NO credentials.
# SLICKTRACE_MODE=real requires all marked [REQUIRED] entries.
# ============================================================

# --- Mode ---
# real | demo
SLICKTRACE_MODE=real

# --- Database (PostgreSQL + PostGIS) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=slicktrace
DB_USER=slicktrace
DB_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://slicktrace:changeme_strong_password@postgres:5432/slicktrace

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=slicktrace_access
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET_IMAGERY=slicktrace-imagery
MINIO_BUCKET_OUTPUTS=slicktrace-outputs
MINIO_BUCKET_DOSSIERS=slicktrace-dossiers
MINIO_USE_SSL=false

# --- Copernicus Data Space (Sentinel-1/2 imagery) [REQUIRED for real SAR fetch] ---
# Register free at https://dataspace.copernicus.eu/
CDSE_USERNAME=
CDSE_PASSWORD=

# --- Copernicus Marine Service (ocean currents) [REQUIRED for CMEMS reader] ---
# Register free at https://marine.copernicus.eu/
CMEMS_USERNAME=
CMEMS_PASSWORD=

# --- ERA5 / CDS API (wind fields) [REQUIRED for ERA5 reader] ---
# Register free at https://cds.climate.copernicus.eu/
# Set ~/.cdsapirc OR provide key+url here
CDS_URL=https://cds.climate.copernicus.eu/api/v2
CDS_KEY=

# --- Global Fishing Watch [OPTIONAL] ---
# Register at https://globalfishingwatch.org/
GFW_API_TOKEN=

# --- INCOIS [OPTIONAL - stub adapter] ---
INCOIS_API_URL=
INCOIS_API_KEY=

# --- Mapbox (Frontend GL JS maps) [REQUIRED for frontend map] ---
# Free tier token from https://mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- ML Service ---
ML_SERVICE_URL=http://ml:8001
ML_WEIGHTS_DIR=/app/weights

# --- Security ---
SECRET_KEY=changeme_32byte_secret_key_here!!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]

# --- Logging ---
LOG_LEVEL=INFO
